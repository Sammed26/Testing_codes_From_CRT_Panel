<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Demo Web Shop">
  
  <test thread-count="5" name="Integration Testing">
    <groups>
    		<run>
    			<include name="integration"></include>
    		</run>
    </groups>
    
    <classes>
    		<class name="login.LoginCheck"/>
    </classes> 
  </test>
  
  <test thread-count="5" name="Regression Testing">
    <groups>
    		<run>
    			<include name="regression"></include>
    			<include name="sam"></include>
    		</run>
    </groups>
    
    <classes>
    		<class name="login.LoginCheck"/>
    		<class name="com.cjc.TestMethod"></class>
    </classes> 
  </test>
  
</suite>
